{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pazua-smart-price",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-14",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pazua-smart-price",
      "database_id": "把你的 D1 Database ID 貼在這裡"
    }
  ]
}
